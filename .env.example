# 复制本文件为 .env 并填入自己的值（.env 已 gitignore）
# 未配置的项对应的统计/验证脚本不会注入到页面 head

# Algolia DocSearch（themeConfig.js 搜索用）
ALGOLIA_APPID=
ALGOLIA_APIKEY=

# 百度站长平台验证码（meta baidu-site-verification）
BAIDU_SITE_VERIFICATION=
# 神马站长验证码
SHENMA_SITE_VERIFICATION=

# 百度统计 hm.js ID
BAIDU_ANALYTICS_ID=

# Google Analytics (gtag) 测量 ID
GOOGLE_ANALYTICS_ID=
# Google AdSense client
GOOGLE_ADSENSE_CLIENT=

# Umami 自建统计
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_SRC=

# Plausible 自建统计
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_SRC=

# Microsoft Clarity 项目 ID
CLARITY_ID=
